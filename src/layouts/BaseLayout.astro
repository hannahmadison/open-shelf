---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Open Shelf — What we're reading, sharing, and thinking about." />
    <title>{title} | Open Shelf</title>
  </head>
  <body class="min-h-screen bg-sand-50 text-ocean-800">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
      <a href="/" class="font-display font-bold text-ocean-900 hover:text-coral-500 transition-colors">
        Open Shelf
      </a>
      <div class="flex items-center gap-6 text-sm font-medium">
        <a href="/" class="text-ocean-500 hover:text-ocean-800 transition-colors">Reads</a>
        <a href="/viz" class="text-ocean-500 hover:text-ocean-800 transition-colors">Viz</a>
      </div>
    </nav>
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <footer class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center text-sand-500 text-sm font-body">
      <p>A community project. Not affiliated with or endorsed by Red Hat, Inc.</p>
    </footer>
  </body>
</html>
