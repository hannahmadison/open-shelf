---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import FilterableGrid from "../components/FilterableGrid";
import { getCollection } from "astro:content";

const reads = await getCollection("reads");
const sortedReads = reads
  .sort((a, b) => b.data.date_added.getTime() - a.data.date_added.getTime())
  .map((entry) => ({
    title: entry.data.title,
    author: entry.data.author,
    type: entry.data.type,
    link: entry.data.link,
    tags: entry.data.tags,
    blurb: entry.data.blurb,
    dateAdded: entry.data.date_added.toISOString().split("T")[0],
    recommendations: entry.data.recommendations ?? 1,
    series: entry.data.series ?? false,
  }));
---

<BaseLayout title="Home">
  <HeroSection />
  <FilterableGrid reads={sortedReads} client:load />
</BaseLayout>

